digraph architecture {
  rankdir=TB;
  compound=true;
  graph [fontname="Noto Sans CJK KR", fontsize=15,
         label="motion_controller.py 아키텍처 + 스레드/노드 spin 관계 (개선)", labelloc=t];
  node  [fontname="Noto Sans CJK KR", fontsize=11];
  edge  [fontname="Noto Sans CJK KR", fontsize=10];

  // ===== 범례 =====
  subgraph cluster_legend {
    label="범례"; style=filled; color="#f5f5f5";
    L1 [label="● 상시 spin",    shape=plaintext, fontcolor="#1565c0"];
    L2 [label="● 호출 시 spin", shape=plaintext, fontcolor="#2e7d32"];
    L3 [label="● 협조적 중단",  shape=plaintext, fontcolor="#c62828"];
    L4 [label="◎ 스레드",       shape=plaintext, fontcolor="#e65100"];
    L5 [label="□ ROS2 노드",    shape=plaintext, fontcolor="#1b5e20"];
  }

  // ===== 외부 =====
  subgraph cluster_ext {
    label="외부 (HMI / 백엔드)"; style=filled; color="#eef4ff";
    HMI [label="HMI 앱 / 웹",         shape=box, style="rounded,filled", fillcolor="#cfe2ff"];
    BE  [label="FastAPI robot_bridge", shape=box, style="rounded,filled", fillcolor="#cfe2ff"];
  }

  // ===== 프로세스 내부 =====
  subgraph cluster_mc {
    label="motion_controller.py (단일 프로세스)";
    style=filled; color="#eafbe7";

    // ---- executor 스레드 풀 (EMER를 안으로) ----
    subgraph cluster_exec_pool {
      label="MultiThreadedExecutor 스레드 풀 ×4\n(상시 spin → NCMD 콜백 처리)";
      style=filled; color="#fff2e0";

      EXEC [label="일반 콜백\nSTART · RETRY_PICK\n→ 워커 스레드 생성 후 즉시 반환",
            shape=octagon, style=filled, fillcolor="#ffd9a0"];

      EMER [label="비상정지 · RESET 콜백\n(같은 스레드 풀에서 실행\n→ 공정과 독립적으로 즉시 처리)",
            shape=octagon, style=filled, fillcolor="#ffc9a0"];
    }

    // ---- 워커 스레드 (독립) ----
    WORKER [label="워커 스레드\n_run_process_worker\n→ run_process() 공정 수행",
            shape=octagon, style=filled, fillcolor="#ffd9a0"];

    // ---- 안전 감시 (다이아몬드) ----
    SAFETY [label="safety_watch()\n비상정지 플래그·외력·파지\n10ms마다 감시",
            shape=diamond, style=filled, fillcolor="#ffe0e0"];

    FLAG [label="_emergency_stop_requested\n(threading.Event)",
          shape=note, style=filled, fillcolor="#fff0a0"];

    SB [label="StatusBus\n상태 토픽 발행",
        shape=box, style="rounded,filled", fillcolor="#9fe39a"];

    // ---- ROS2 노드 ----
    subgraph cluster_nodes {
      label="ROS2 노드 (통신 창구 · 스스로 돌지 않음)";
      style=filled; color="#e3f7e0";
      NCMD  [label="g_node\n명령 구독 + 상태 발행",  shape=component, style=filled, fillcolor="#c7f0c2"];
      NDSR  [label="dsr_node\n모션 · 그리퍼 API",    shape=component, style=filled, fillcolor="#c7f0c2"];
      NSTOP [label="stop_node\n정지 · 상태조회 서비스", shape=component, style=filled, fillcolor="#c7f0c2"];
    }
  }

  // ===== 하드웨어 =====
  subgraph cluster_hw {
    label="하드웨어"; style=filled; color="#ffe9d6";
    DSR [label="두산 DSR 컨트롤러", shape=box, style="rounded,filled", fillcolor="#ffd9a0"];
    RG2 [label="OnRobot RG2 그리퍼", shape=box, style="rounded,filled", fillcolor="#ffd9a0"];
  }

  // ===== 명령/상태 흐름 =====
  HMI -> BE;
  BE  -> NCMD [label="/robot/command (JSON)"];
  NCMD -> SB;
  SB  -> BE [style=dashed,
             label="/robot/process_state · safety_event\nrecovery_stage · gripper/status"];

  // ===== spin 관계 =====
  // 상시 spin
  cluster_exec_pool -> NCMD [label="상시 spin", color="#1565c0",
                              penwidth=2.2, fontcolor="#1565c0", ltail=cluster_exec_pool];

  // 일반 콜백 → 워커 생성
  EXEC -> WORKER [label="스레드 생성\n즉시 반환", style=dashed, color="#555555"];

  // 워커 → dsr_node 호출 시 spin
  WORKER -> NDSR [label="호출 시 spin\n(movej · check_motion\n· get_tool_force ...)",
                  color="#2e7d32", penwidth=2.2, fontcolor="#2e7d32"];

  // 비상정지 콜백 → stop_node 호출 시 spin
  EMER -> NSTOP [label="호출 시 spin\n(MoveStop · GetRobotState)",
                 color="#c62828", penwidth=2.2, fontcolor="#c62828"];

  // ===== 협조적 중단 (3단계 명시) =====
  EMER   -> FLAG   [label="set()", color="#c62828", penwidth=1.8];
  FLAG   -> SAFETY [label="is_set() 확인", color="#c62828", style=dashed];
  SAFETY -> WORKER [label="EmergencyStopError\n→ 공정 루프 탈출",
                    color="#c62828", style=dashed, penwidth=1.8];

  // 워커 종료 조건
  WORKER -> EXEC [label="COMPLETE 또는\nEmergencyStopError\n→ 스레드 종료",
                  style=dotted, color="#888888", constraint=false];

  // 워커 안에서 safety_watch 호출
  WORKER -> SAFETY [label="10ms마다 호출", color="#c62828", style=dashed];

  // ===== 노드 → 하드웨어 =====
  NDSR  -> DSR [label="movej / movel / move_periodic"];
  NDSR  -> RG2 [label="/onrobot/sendCommand"];
  NSTOP -> DSR [label="MoveStop / GetRobotState", color="#c62828"];

  // 레이아웃 힌트
  { rank=same; EXEC; EMER; WORKER; }
  { rank=same; NCMD; NDSR; NSTOP; }
}